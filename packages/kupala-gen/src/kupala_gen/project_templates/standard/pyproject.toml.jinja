[project]
name = {{ name | tojson }}
version = "0.1.0"
requires-python = ">=3.14"
dependencies = [
  "kupala>=0.60.0",
  "pydantic-settings>=2.15.0",
  "uvicorn>=0.52.1",
]

[build-system]
requires = ["uv_build>=0.12.5,<0.13"]
build-backend = "uv_build"

[project.entry-points."kupala.app"]
app = "{{ package }}.app:app"

[dependency-groups]
dev = ["pytest>=9.0.0", "pytest-cov>=7.1.0", "ruff>=0.16.6"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.uv.build-backend]
module-root = ""
module-name = "{{ package }}"
