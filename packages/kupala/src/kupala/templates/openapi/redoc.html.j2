<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{ title }}</title>
    </head>
    <body>
        <div id="redoc"></div>
        <script src="{{ base_url }}/redoc.standalone.js"></script>
        {#- `tojson` is the only escaping that holds inside a script element: autoescaping targets HTML #}
        <script nonce="{{ nonce }}">
            const specUrl = {{ spec_url|tojson }};
            Redoc.init(specUrl, {}, document.getElementById("redoc"));
        </script>
    </body>
</html>
